{
  "id": "springer-nature",
  "name": "Springer / Nature",
  "version": 1,
  "type": "web",
  "matches": ["springer.com", "springeropen.com", "nature.com", "biomedcentral.com"],
  "patterns": ["link\\.springer\\.com/(article|chapter)/", "nature\\.com/articles/", "\\.(springeropen|biomedcentral)\\.com/articles/"],
  "note": "Springer Link / Nature / BMC 论文页。",
  "steps": [
    { "op": "fetch" },
    { "op": "meta", "pick": "citation_title", "as": "title" },
    { "op": "meta", "pick": "citation_author", "as": "authors", "multi": true },
    { "op": "meta", "pick": "citation_journal_title", "as": "venue" },
    { "op": "meta", "pick": "citation_online_date", "as": "year", "re": "(\\d{4})" },
    { "op": "meta", "pick": "citation_publication_date", "as": "year", "re": "(\\d{4})", "ifEmpty": true },
    { "op": "meta", "pick": "citation_doi", "as": "doi" },
    { "op": "meta", "pick": "citation_volume", "as": "volume" },
    { "op": "meta", "pick": "citation_issue", "as": "issue" },
    { "op": "meta", "pick": "citation_firstpage", "as": "pages" },
    { "op": "meta", "pick": "dc.description", "as": "abstract", "ifEmpty": true },
    { "op": "meta", "pick": "citation_pdf_url", "as": "_pdfurl" },
    { "op": "download", "url": "{_pdfurl}" }
  ]
}
