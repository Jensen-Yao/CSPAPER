{
  "name": "cspaper",
  "version": "0.21.0",
  "description": "CSPAPER — PDF 文献阅读 + 划词翻译 + LLM 问答 + 全库 RAG",
  "main": "out/main/index.js",
  "productName": "CSPAPER",
  "author": "Jensen-Yao",
  "license": "Apache-2.0",
  "homepage": "https://github.com/Jensen-Yao/CSPAPER#readme",
  "repository": "github:Jensen-Yao/CSPAPER",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "rebuild": "electron-rebuild -f -w better-sqlite3",
    "dist": "electron-vite build && electron-builder",
    "dist:win": "electron-vite build && electron-builder --win",
    "dist:mac": "electron-vite build && electron-builder --mac",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.tests.json --noEmit",
    "test:core": "node scripts/test-core.mjs",
    "test:ui": "node scripts/test-ui.mjs",
    "check": "npm run typecheck && npm run test:core && npm run build && npm run test:lifecycle && npm run test:ui && npm run bench",
    "test:chat": "node scripts/test-core.mjs",
    "bench:library": "node scripts/bench-library.mjs",
    "bench:chat": "node scripts/bench-chat.mjs",
    "bench": "npm run bench:library && npm run bench:chat",
    "test:lifecycle": "node scripts/test-single-instance.mjs && node scripts/test-window-cleanup.mjs && node scripts/test-operation-crash.mjs && node scripts/test-tray-restore.mjs",
    "test:installer": "node scripts/test-installer.mjs",
    "test:mobile": "node scripts/mobile-test.mjs"
  },
  "build": {
    "appId": "com.jensenyao.cspaper",
    "productName": "CSPAPER",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**"
    ],
    "extraResources": [
      {
        "from": "resources/translators",
        "to": "translators"
      },
      {
        "from": "resources/csl-catalog.json",
        "to": "csl-catalog.json"
      },
      {
        "from": "extension",
        "to": "extension"
      },
      {
        "from": "resources/skills",
        "to": "skills"
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "shortcutName": "CSPAPER"
    },
    "mac": {
      "icon": "build/icon.icns",
      "category": "public.app-category.productivity",
      "identity": null,
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ]
    },
    "publish": {
      "provider": "github",
      "releaseType": "release"
    }
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^3.0.53",
    "@huggingface/transformers": "^3.5.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@tanstack/react-virtual": "^3.14.23",
    "ai": "^7.0.107",
    "better-sqlite3": "^11.9.0",
    "cheerio": "^1.2.0",
    "pdfjs-dist": "^4.10.38",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.7.0",
    "@types/better-sqlite3": "^7.6.11",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^35.0.0",
    "electron-builder": "^26.0.12",
    "electron-vite": "^3.0.0",
    "playwright-core": "^1.63.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  }
}
